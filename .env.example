# FlareSolverr instance (required only for Cloudflare-gated mirrors)
FLARESOLVERR_URL=http://localhost:8191/v1

# Upstream proxy for ALL site/player requests.
# The Kinogo players are geo-locked to RU/CIS — without a RU exit they return
# "видео недоступно для вашего региона". Format: http://user:pass@host:port
PROXY_URL=

# Comma-separated mirror list, tried in order.
KINOGO_MIRRORS=https://kinogo.la,https://kinogo.media,https://kinogo1.biz

# Cache TTL seconds
CACHE_TTL=900

# Delegate only the /stream resource to an instance that has a Russian exit.
# Set this on Vercel (serverless cannot host a VPN); leave it empty on the
# machine that actually holds the tunnel, or it will call itself.
UPSTREAM_URL=
